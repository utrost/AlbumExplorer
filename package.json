{
  "name": "album-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "import:rolling-stone": "node scripts/import-rolling-stone-csv.js data/imports/rolling-stone-top-500.csv data/collection.json --limit 20",
    "enrich:discogs": "node scripts/enrich-discogs.js data/collection.json data/collection.discogs.json",
    "parse:rolling-stone-html": "node scripts/parse-rolling-stone-html.js",
    "parse:rolling-stone-text": "node scripts/parse-rolling-stone-text.js",
    "build:rolling-stone-comparison": "node scripts/build-rolling-stone-comparison.js",
    "enrich:album-metadata": "node scripts/enrich-album-metadata.js",
    "import:musicbrainz": "node scripts/import-musicbrainz-source-candidates.js",
    "import:discogs-credits": "node scripts/import-discogs-credit-candidates.js",
    "import:discogs-profile-gaps": "node scripts/import-discogs-credit-candidates.js data/rolling-stone-comparison.json data/enrichment/album-credit-profile-gap-candidates.json --profile-gaps data/enrichment/album-profile-gaps.json --missing coverArt,tracklist",
    "import:cover-art-archive": "node scripts/import-cover-art-archive-candidates.js",
    "import:musicbrainz-releases": "node scripts/import-musicbrainz-release-candidates.js",
    "import:musicbrainz-work-credits": "node scripts/import-musicbrainz-work-credit-candidates.js",
    "import:wikidata-stories": "node scripts/import-wikidata-story-candidates.js",
    "build:discogs-credit-review": "node scripts/build-discogs-credit-review.js",
    "build:album-profile-gaps": "node scripts/build-album-profile-gaps.js",
    "build:app-dataset": "node scripts/build-app-dataset.js"
  }
}
